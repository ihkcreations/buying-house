generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- 1. USER MANAGEMENT ---
model User {
  id            String    @id @map("_id") // Removed @db.ObjectId and @default(auto())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String?   @default("merchandiser")
  
  sessions      Session[]
  accounts      Account[]

  @@map("user") // Optional: good practice for mongo
}

enum Role {
  ADMIN
  MERCHANDISER
  COMMERCIAL
  FINANCE
}

// --- 2. MASTER DATA (The "Library") ---
model Buyer {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  country String
  orders  Order[]
}

model Factory {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  address String
}

// --- 3. THE ORDER (The Heart) ---
model Order {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orderNo     String   @unique // #139679
  styleNo     String
  season      String
  
  // Relationships
  buyerId     String   @db.ObjectId
  buyer       Buyer    @relation(fields: [buyerId], references: [id])
  
  // Merchandising Core
  orderQty    Int
  unitPrice   Float    // FOB
  totalValue  Float    // Auto-calculated (Qty * Price)
  currency    String   @default("USD")

  // THE MATRIX (Solves your Figma "List vs Matrix" issue)
  // Data Structure: [{ color: "Red", sizes: { S: 10, M: 20, L: 10 } }]
  sizeColorMap Json    

  status      OrderStatus @default(PENDING)
  
  // Modules
  costing         Costing?
  timeAction      TimeAction?
  fabricBookings  FabricBooking[]
  samples         Sample[]
  productionLogs  ProductionLog[]
  
  // Commercial
  proformaInvoice ProformaInvoice?
  salesContract   SalesContract?
  commercialDocs  CommercialDoc[]

  actualCosting   ActualCosting?
  activityLogs    ActivityLog[]

  packingList     PackingList?

  expenses        Expense[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  COSTING_APPROVED
  FABRIC_BOOKED
  IN_PRODUCTION
  SHIPPED
  OCS_FINALIZED
  CLOSED
}

// --- 4. COSTING MODULE (Production Grade) ---
model Costing {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @unique @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // A. Direct Costs
  fabricCostPerDzn   Float   @default(0)
  trimsCostPerDzn    Float   @default(0) // Sum of breakdown
  accessoriesBreakdown Json? // Store details: { thread: 0.5, poly: 0.1, etc. }
  
  printingCost       Float   @default(0)
  embroideryCost     Float   @default(0)
  washingCost        Float   @default(0)
  cmCostPerDzn       Float   @default(0) // Making Charge

  // B. Indirect Costs / Overheads
  labTestCost        Float   @default(0)
  inspectionCost     Float   @default(0)
  samplingCost       Float   @default(0)
  commercialCost     Float   @default(0)
  logisticsCost      Float   @default(0)
  
  // C. Pricing
  totalCost          Float   @default(0) // A + B
  profitMargin       Float   @default(0) // The Profit $
  commissionPercent  Float   @default(0) // The Agency Fee %
  
  netFob             Float   @default(0) // Final Price Quote
  
  isApproved         Boolean @default(false)
  updatedAt          DateTime @updatedAt
}

// --- 5. T&A MODULE ---
model TimeAction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @unique @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Milestones (Plan vs Actual)
  labDipPlan      DateTime?
  labDipActual    DateTime?
  
  fabricPlan      DateTime?
  fabricActual    DateTime? // Critical: Fabric In-house
  
  cuttingPlan     DateTime?
  cuttingActual   DateTime?
  
  sewingPlan      DateTime?
  sewingActual    DateTime?
  
  shipmentPlan    DateTime
  shipmentActual  DateTime?
}

// --- 6. FABRIC BOOKING ---
model FabricBooking {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // 1. Classification
  type         String   @default("BODY") // "BODY", "RIB", "COLLAR"
  
  // 2. Technical Specs (The Recipe)
  composition  String   // "100% Cotton"
  construction String   // "Single Jersey"
  yarnCount    String   // "26/1 Combed"
  gsm          String?  // "160"
  dia          String?  // "Dia 30 Open" or "72 inch"
  stitchLength String?  // "2.90"
  
  // 3. The Math
  consumption  Float    // kg/dzn
  wastage      Float    // %
  requiredQty  Float    // Calculated
  
  // 4. Logistics
  supplier     String?
  color        String?  // If booking specific color (e.g., Yarn Dyed)
  
  createdAt    DateTime @default(now())
}

// --- 7. SAMPLE MODULE ---
model Sample {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  type      SampleType // PROTO, FIT, PP
  version   Int        // 1, 2, 3 (To track resubmissions)
  
  sentDate  DateTime?
  courier   String?    // DHL/FedEx
  trackingNo String?   // Added based on review
  
  status    SampleStatus @default(PENDING)
  comments  String?
}

enum SampleType {
  PROTO
  FIT
  PP
  TOP
}

enum SampleStatus {
  PENDING
  APPROVED
  REJECTED
  RESUBMIT
}

// --- 8. PRODUCTION LOG ---
model ProductionLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  date      DateTime
  
  // Daily Input
  cutQty    Int @default(0)
  sewQty    Int @default(0)
  packQty   Int @default(0)
  
  reportUrl String? // UploadThing URL
}

// --- 9. COMMERCIAL ---
model ProformaInvoice {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @unique @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  piNumber  String
  date      DateTime
  supplierAddress String?
  bankDetails String
  
  // --- THE 12 TERMS & CONDITIONS ---
  payment         String?
  blClause        String?
  tolerance       String?
  freightTerm     String?
  portLoading     String?
  partialShipment String?
  charges         String?
  insurance       String?
  lcTerm1         String?
  lcTerm2         String?
  portDischarge   String?
  documents       String?

  // Items are complex (style, article, dates), so we keep them as JSON
  items     Json 

  generationCount Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesContract {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @unique @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  scNumber  String   // "Purchase Order No.INO/PIO/..."
  scDate    DateTime
  
  // --- PARTIES ---
  vendorAddress   String? // "Address of Vendor"
  consignee       String? // "Address/Consignee"
  
  // --- BANKING ---
  vendorBank      String? // "Vendor's bank"
  buyerBank       String? // "LC/TT Opening Bank" (NEW)
  negotiatingBank String? // "Negotiating Bank" (NEW)
  
  // --- TERMS (Mapped to your PDF) ---
  deliveryTerm    String? // "Terms of Delivery" (FCA/FOB)
  shipmentMode    String? // "Mode of Shipment"
  paymentTerm     String? // "Payment Term"
  tolerance       String?
  partialShipment String?
  transShipment   String? // "Trans Shipment"
  portDischarge   String?
  finalDest       String? // "Port of Delivery / Final Dest"
  portLoading     String?
  latestShipDate  String? // "Latest Date of Shipment"
  expiryDate      String? // "Date and Place of Expiry"
  insurance       String?
  specialCondition String?
  
  // --- LONG TEXT BLOCKS ---
  docRequired     String? // "Documents Required"
  lateClause      String? // "Late Delivery Clause" (The big text block)

  generationCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- 10. COMMERCIAL DOCUMENTS ---
model CommercialDoc {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  name      String   // "L/C", "Bill of Lading"
  type      String   // "UPLOADED"
  url       String   // File URL
  status    String   // "PENDING", "COMPLETED"
  
  createdAt DateTime @default(now())
}


// --- BETTER AUTH MODELS ---

model Session {
  id        String   @id @map("_id")
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime
  updatedAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id           String    @id @map("_id") // Removed @db.ObjectId
  userId       String    // Removed @db.ObjectId
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime
  updatedAt    DateTime

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @map("_id") // Removed @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// --- 11. GLOBAL SETTINGS ---
model CompanySettings {
  id        String   @id @map("_id") 
  
  // Tab 1: General
  companyName    String   @default("P.I. OCEAN TEX")
  contactPhone   String?
  contactEmail   String?
  
  // Relations
  addresses      OfficeAddress[] // <--- ADD THIS
  
  // ... Keep existing Bank & Defaults fields ...
  bankName       String?
  bankAddress    String?
  swiftCode      String?
  accountNumber  String?
  accountName    String?
  defaultPaymentTerms String?
  defaultPort         String?

  manualExchangeRate Float?
  
  updatedAt DateTime @updatedAt
}

// --- NEW MODEL ---
model OfficeAddress {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  settingsId  String   @map("settings_id")
  settings    CompanySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  
  label       String   // e.g. "Head Office", "London Branch"
  addressText String   // The full address block
  isDefault   Boolean  @default(false)
}

// --- 12. OCS (ORDER COST SHEET / ACTUALS) ---
model ActualCosting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @unique @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Note: These are TOTAL dollar amounts for the whole order, not per dozen
  fabricActual      Float   @default(0)
  trimsActual       Float   @default(0)
  printingActual    Float   @default(0)
  embroideryActual  Float   @default(0)
  washingActual     Float   @default(0)
  cmActual          Float   @default(0) // Total paid to factory

  labTestActual     Float   @default(0)
  inspectionActual  Float   @default(0)
  samplingActual    Float   @default(0)
  commercialActual  Float   @default(0)
  logisticsActual   Float   @default(0) // The dangerous one (Air freight)
  
  updatedAt DateTime @updatedAt
}

// --- 13. ACTIVITY LOG ---
model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // Who did it?
  userId    String
  userName  String
  userRole  String
  
  // What happened?
  action    String   // e.g. "UPDATED_COSTING", "CREATED_PI"
  details   String   // e.g. "Approved Costing for Order #1099"

  documentCount Int?
  
  // Related to which Order? (Optional, but recommended)
  orderId   String?  @db.ObjectId
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model PackingList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @unique @db.ObjectId
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  invoiceNo String   // Usually same as Commercial Invoice No
  date      DateTime
  
  // Carton Specs
  totalCartons  Int
  cartonSize    String // "60x40x30 cm"
  netWeight     Float  // Total NW
  grossWeight   Float  // Total GW
  cbm           Float  // Cubic Meter Volume
  
  // Content
  description   String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- 14. FINANCE / EXPENSES ---
model Expense {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  
  userId    String   // Who spent it (BetterAuth ID)
  userName  String   // Cache name for display
  
  category  String   // Travel, Food, Sample, Courier, Other
  amount    Float
  exchangeRate  Float    @default(1)
  date      DateTime
  description String?
  
  // Optional: Link to Order
  orderId   String?  @db.ObjectId
  order     Order?   @relation(fields: [orderId], references: [id])
  
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  receiptUrl String? // Image of bill

  currency  String   @default("BDT")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}